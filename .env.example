# Frontend settings for the AI Voice Mock Interview. Copy to `.env.local`.
# Everything prefixed VITE_ is bundled into the browser code, so never put an
# API key here. AI keys (GROQ_API_KEY / ANTHROPIC_API_KEY) belong in Streamlit secrets.

# auto | ollama | server | offline
#   auto: the server AI when running inside Streamlit with a key set,
#         Ollama when VITE_OLLAMA_MODEL/URL is set, otherwise offline scoring.
VITE_AI_PROVIDER=auto

# Local Ollama server (only used for local development).
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen3:8b
